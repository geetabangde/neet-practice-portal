{
  "name": "neet-practice-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API server for the NEET PG practice portal",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed:admin": "tsx src/scripts/seed-admin.ts",
    "seed:subjects": "tsx src/scripts/seed-subjects.ts",
    "db:setup": "tsx src/scripts/db-setup.ts",
    "seed:plans": "tsx src/scripts/seed-plans.ts",
    "db:export-sql": "tsx src/scripts/export-sql.ts",
    "admin:sql": "tsx src/scripts/admin-sql.ts",
    "seed:demo": "tsx src/scripts/seed-demo.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
