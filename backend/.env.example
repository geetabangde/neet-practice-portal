# Copy this file to ".env" and change the values. Never commit the real ".env".
PORT=5000

# The address of the student frontend. Only this origin may call the API from a browser.
FRONTEND_ORIGIN=http://localhost:3000

# The address of the admin panel.
ADMIN_ORIGIN=http://localhost:3001

# MySQL (XAMPP). If the root account has no password, leave DB_PASSWORD empty.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=neet_pg_portal

# Admin login tokens. JWT_SECRET must be a long random string (32+ characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d

# Used only by "npm run seed:admin" to create the first admin. Remove the password afterwards.
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_this_password
